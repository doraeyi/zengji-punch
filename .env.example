# ── 資料庫（必填）────────────────────────────────
# 自架在 NAS 的 MySQL（對外 port 13306）。主要用 liam.name404.com，
# 它連不上時（例如被放到 Cloudflare 後面，13306 過不去）會自動改連備用主機。
DATABASE_URL="mysql://zengji:請換成密碼@liam.name404.com:13306/zengji_punch"
# 備用主機（host:port，多個用逗號隔開），帳號密碼與資料庫名稱沿用 DATABASE_URL
DATABASE_FALLBACK_HOSTS="kaikaizhen.myasustor.com:13306"

# NAS 的 MySQL 只能經 Cloudflare 通道 db-liam.name404.com 連：填 Service Token 就會走通道（DATABASE_URL 的主機名稱就不用了）
CF_ACCESS_CLIENT_ID=""
CF_ACCESS_CLIENT_SECRET=""

# ── 手機推播（Web Push / VAPID，選填，沒填就不推播）──
# 執行 npx web-push generate-vapid-keys 產生一組，公私鑰要成對。換金鑰後所有人要重新開啟通知。
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
# 推播服務（Google / Apple）有問題時聯絡你用，填 mailto:你的email
VAPID_SUBJECT="mailto:you@example.com"

# ── 排程提醒（選填）── 部署在 Vercel 這類沒有常駐伺服器的平台才需要
# 外部排程每分鐘呼叫 https://你的網域/api/cron/reminders，並帶 Authorization: Bearer <這把鑰匙>
CRON_SECRET=""
