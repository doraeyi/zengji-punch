# ── 資料庫（必填）────────────────────────────────
# 自架在 NAS 的 MySQL（對外 port 13306）。要用直連的 kaikaizhen.myasustor.com，
# 不能用 liam.name404.com（那個走 Cloudflare 代理，MySQL 連不過去）。
DATABASE_URL="mysql://zengji:請換成密碼@kaikaizhen.myasustor.com:13306/zengji_punch"

# ── 手機推播（Web Push / VAPID，選填，沒填就不推播）──
# 執行 npx web-push generate-vapid-keys 產生一組，公私鑰要成對。換金鑰後所有人要重新開啟通知。
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
# 推播服務（Google / Apple）有問題時聯絡你用，填 mailto:你的email
VAPID_SUBJECT="mailto:you@example.com"

# ── 排程提醒（選填）── 部署在 Vercel 這類沒有常駐伺服器的平台才需要
# 外部排程每分鐘呼叫 https://你的網域/api/cron/reminders，並帶 Authorization: Bearer <這把鑰匙>
CRON_SECRET=""
